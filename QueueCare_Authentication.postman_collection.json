    {
      "name": "1. Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('=== Register User Test ===');",
              "",
              "// Test 1: Check status code",
              "pm.test('Status code is 201 (Created)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Test 2: Verify response body structure",
              "pm.test('Response contains required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('userId');",
              "    pm.expect(jsonData).to.have.property('email');",
              "    pm.expect(jsonData).to.have.property('role');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});",
              "",
              "// Test 3: Verify email matches request",
              "pm.test('Email matches registration request', function () {",
              "    var jsonData = pm.response.json();",
              "    var requestBody = JSON.parse(pm.request.body.raw);",
              "    pm.expect(jsonData.email).to.equal(requestBody.email);",
              "});",
              "",
              "// Test 4: Verify default role is PATIENT",
              "pm.test('Default role is PATIENT', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.role).to.equal('PATIENT');",
              "});",
              "",
              "// Test 5: Verify no token is returned on registration",
              "pm.test('Token is null on registration (login required)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.null;",
              "});",
              "",
              "// Store user data for subsequent tests",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('registeredUserId', jsonData.userId);",
              "    pm.environment.set('registeredEmail', jsonData.email);",
              "    console.log('✓ User registered successfully');",
              "    console.log('User ID: ' + jsonData.userId);",
              "    console.log('Email: ' + jsonData.email);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"patient1@queuecare.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
