        {
          "name": "Set Base URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('baseUrl', 'http://localhost:8080/api');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        }
      ]
