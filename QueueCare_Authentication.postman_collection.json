    {
      "name": "3. Access Protected API - Get User by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('=== Protected API Access Test ===');",
              "",
              "// Test 1: Check status code",
              "pm.test('Status code is 200 (OK) for authenticated request', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Verify response contains user data",
              "pm.test('Response contains user details', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('email');",
              "    pm.expect(jsonData).to.have.property('role');",
              "});",
              "",
              "// Test 3: Verify user data matches authenticated user",
              "pm.test('User data matches authenticated user', function () {",
              "    var jsonData = pm.response.json();",
              "    var userId = pm.environment.get('userId');",
              "    pm.expect(jsonData.id).to.equal(userId);",
              "    pm.expect(jsonData.email).to.equal(pm.environment.get('registeredEmail'));",
              "});",
              "",
              "// Test 4: Verify response does not contain password",
              "pm.test('Response does not contain password field', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.not.have.property('password');",
              "});",
              "",
              "console.log('✓ Protected API access successful with JWT');",
              "var jsonData = pm.response.json();",
              "console.log('User ID: ' + jsonData.id);",
              "console.log('Email: ' + jsonData.email);",
              "console.log('Role: ' + jsonData.role);"
            ]
          }
        }
      ],
